# ============================================================
# 校招全流程助手 · 生产环境变量模板（云端部署用）
# ============================================================
#
# 怎么用：
#   在服务器上执行
#       cp backend/.env.production.example backend/.env
#       vi backend/.env          # 按下面【必改】逐项填写
#   然后 deploy/deploy.sh 会自动读取 backend/.env 并注入容器。
#
#   ⚠️ 文件名必须是 backend/.env —— 程序只认这个路径（app/config.py 里写死了），
#      模板本身不会被读取。backend/.env 已被 .gitignore 忽略，不要提交到 GitHub。
#
# 也可以直接把你本机那套能跑的 backend/.env 传到服务器（最快、不易填错）：
#   scp backend/.env root@<服务器IP>:/opt/ai-interview-coach/backend/.env
#   但那样会带上本机的 CORS_ORIGINS 等配置，请对照下面【必改】核对一遍。
#
# 本文件里的值全部是「云端生产」口径，与 backend/.env.example（开发口径）的差异都写了原因。

# ============================================================
# 一、大模型（决定面试官会不会说话、评分是不是真 AI）
# ============================================================
# auto | deepseek | dashscope | zhipu | moonshot | openai | ollama | mock
# auto = 按顺序挑第一个填了 key 的厂商。留空全部 key 时会退化成规则引擎演示模式
#        （能跑通，但题目和点评是模板化的，不适合正式对外）。
LLM_PROVIDER=auto

# 【必改】至少填一个 key，否则线上就是演示模式。
# 自检：启动日志会打印「LLM 已启用：deepseek / deepseek-chat」，
#       或访问 https://你的域名/api/health/llm 查看未生效的原因。
# ① DeepSeek   控制台 https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ② 通义千问（阿里云百炼） https://bailian.console.aliyun.com
#    如果服务器买在阿里云，同地域调用这个延迟最低，推荐优先选它。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# ③ 智谱 GLM  https://open.bigmodel.cn
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash

# ④ 月之暗面 Kimi  https://platform.moonshot.cn
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-8k

# ⑤ OpenAI（国内服务器直连通常不通，要用得自备代理地址）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ⑥ 本地 Ollama（云端一般不用；因不参与 auto 探测，必须显式设 LLM_PROVIDER=ollama）
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# 单次大模型请求超时（秒）。保持 120：
# 轻量模型做「整份简历结构化」要 70–90 秒，调小会导致每次超时降级。
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# ============================================================
# 二、语音（面试官的声音 + 你的语音作答）
# ============================================================
# auto | edge | browser | aliyun
#   edge    = 微软 edge-tts，免费无需 key。默认值，但从**国内服务器**调用
#             Microsoft 语音服务延迟偏高且偶尔不稳；
#             本项目有 3.5 秒预算（TTS_EDGE_TIMEOUT_SECONDS），超时会先用浏览器
#             语音顶上、后台继续合成并缓存，所以体验不会崩，只是音质不稳定。
#   aliyun  = 阿里云语音合成，走 RESTful HTTP，**不需要装 SDK**。
#             服务器在阿里云 / 腾讯云且已有语音密钥时，这是线上最稳的选择。
#   browser = 完全不调用后端语音，用浏览器自带语音朗读（零成本、零依赖）。
TTS_PROVIDER=auto
TTS_VOICE_FEMALE=zh-CN-XiaoxiaoNeural
TTS_VOICE_MALE=zh-CN-YunxiNeural
# 超过这个秒数就先降级浏览器语音，后台继续合成并写入缓存，保证「AI 响应 ≤3 秒」
TTS_EDGE_TIMEOUT_SECONDS=3.5

# auto | browser | aliyun
#   browser = 浏览器 Web Speech API（需 Chrome / Edge）。
#             注意：浏览器识别会把音频送到厂商服务器，且**必须 HTTPS**。
#   aliyun  = 阿里云实时语音识别，需要额外安装 SDK（镜像构建参数 INSTALL_NLS_SDK=1），
#             否则启动日志会说明「已降级为浏览器识别」。
ASR_PROVIDER=auto

# 阿里云语音凭据（仅当上面选了 aliyun 才需要；TTS 只需 AccessKey + AppKey）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_TTS_APPKEY=
ALIYUN_TTS_TOKEN=
ALIYUN_ASR_APPKEY=

# ============================================================
# 三、数据存储（容器内的路径，不用改）
# ============================================================
# 这三个都是相对 backend/ 的路径，容器里对应 /app/backend/data/...，
# 而该目录已被 docker-compose.yml 绑定挂载到宿主机的 backend/data/，因此**不要改**。
# 改成绝对路径或别的目录会导致「重启后用户数据不见了」。
DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./data/uploads
TTS_CACHE_DIR=./data/tts_cache
MAX_UPLOAD_MB=5

# ============================================================
# 四、跨域与登录
# ============================================================
# 【必改】填你的正式访问地址。前端与后端同域部署，正常流程根本不触发跨域，
# 所以这里最安全的写法是**只列自己的域名**，而不是开发期的 *。
# 先用 IP 测试阶段可暂时写 http://<公网IP>；绑好域名后改成 https://你的域名。
# 多个用英文逗号分隔，末尾不要带斜杠。
CORS_ORIGINS=https://interview.example.com

# 登录令牌有效期（小时）。30 天，退出登录会立即吊销。
AUTH_TOKEN_TTL_HOURS=720

# 是否允许游客试用（不登录也能跑一遍面试，但不保存任何数据、重启即消失）。
#   true （默认）：降低第一次使用的门槛，适合公开推广。
#   false        ：未登录一律 401，数据完全私有，适合小范围内测。
ALLOW_GUEST=true

# ============================================================
# 六、业务参数
# ============================================================
DEFAULT_QUESTION_COUNT=9
MAX_ANSWER_SECONDS=300
# 进行中的面试空闲超过该小时数自动收敛为 aborted；0 表示关闭
SESSION_IDLE_TIMEOUT_HOURS=6
