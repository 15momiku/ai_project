# ===== 校招全流程助手 · 环境变量模板 =====
# 使用方法：复制本文件为 .env，然后在 .env 里填写。
# ⚠️ 只改 .env 才生效，.env.example 只是模板，程序不会读取它。
# 全部留空 = 全离线演示模式（规则引擎 + 浏览器语音），项目依然可以完整跑通。

# ---------- 大模型（文档 §6.1）----------
# 所有厂商都走 OpenAI 兼容协议，填哪家的 key 就用哪家。
# LLM_PROVIDER 可选：auto | deepseek | dashscope | zhipu | moonshot | openai | ollama | mock
#   auto  = 按下述顺序自动挑选「第一个填了 key」的厂商
#   mock  = 强制使用规则引擎（不调大模型）
# 填好后重启后端；接口 GET /api/health/llm 会明确告诉你当前用的是哪家、没生效的原因
LLM_PROVIDER=auto

# ① DeepSeek  https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ② 通义千问（阿里云百炼 DashScope 兼容模式）  https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# ③ 智谱 GLM  https://open.bigmodel.cn
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash

# ④ 月之暗面 Kimi  https://platform.moonshot.cn
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-8k

# ⑤ OpenAI（国内直连通常不通，需要自备代理地址）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ⑥ 本地 Ollama（不需要 key；因不参与 auto 探测，必须把 LLM_PROVIDER 设为 ollama 才启用）
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# 单次大模型请求超时（秒）。默认 120s：
# 免费/轻量模型（如 glm-4-flash）解析整份简历要 70-90 秒，设太小会每次都超时降级到规则引擎。
# 超时不重试（重试会让等待时间成倍放大），只有网络抖动/限流才重试。
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# ---------- 语音合成 TTS（文档 §4.2.2）----------
# auto | edge | browser | aliyun
# edge  = 微软 edge-tts，免费、无需 key（默认）
# browser = 不使用后端音频，前端用浏览器原生语音朗读
# aliyun = 阿里云智能语音：填下面的凭据即可，走 RESTful HTTP，**无需安装 SDK**
#          （若另装了 NLS SDK 则优先走 WebSocket 长文本链路）
TTS_PROVIDER=auto
TTS_VOICE_FEMALE=zh-CN-XiaoxiaoNeural
TTS_VOICE_MALE=zh-CN-YunxiNeural
# edge-tts 时间预算（秒）：超过即先用浏览器语音，后台继续合成并缓存，保证「AI 响应 ≤3 秒」
TTS_EDGE_TIMEOUT_SECONDS=3.5

# ---------- 语音识别 ASR（文档 §4.2.3）----------
# auto | browser | aliyun（browser = 浏览器 Web Speech API，需 Chrome/Edge）
ASR_PROVIDER=auto

# ---------- 阿里云语音凭据（仅当上面选了 aliyun 才需要）----------
# 留空时 tts_status()/asr_status() 会明确降级为 browser，不会误报成 aliyun
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_TTS_APPKEY=
ALIYUN_TTS_TOKEN=
ALIYUN_ASR_APPKEY=

# ---------- 数据与上传 ----------
DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=5
TTS_CACHE_DIR=./data/tts_cache

# ---------- 业务参数 ----------
DEFAULT_QUESTION_COUNT=9
MAX_ANSWER_SECONDS=300
# 进行中的面试「空闲」超过该小时数后自动收敛为 aborted（后端启动时 + 每次读取会话状态时检查）。
# 计时基准是最后一次对话活动时间；设为 0 表示关闭自动收敛。
SESSION_IDLE_TIMEOUT_HOURS=6

# ---------- 账号与数据私有 ----------
# 登录令牌有效期（小时）。退出登录会立即吊销令牌，不依赖过期时间。
AUTH_TOKEN_TTL_HOURS=720

# 是否允许「游客试用」。
#   true （默认）：未登录也能完整跑一遍（面试 + 评分报告），但**不保存任何数据**——
#                 游客的数据走进程内内存库：不落盘、重启即消失，也读不到登录用户的数据；
#                 「我的面试」「简历优化」对游客隐藏（数据本来就不存在）。
#   false：未登录请求一律 401，数据完全私有，前端会把用户拦到 /login。
ALLOW_GUEST=true

# ---------- 允许的跨域来源 ----------
CORS_ORIGINS=*
